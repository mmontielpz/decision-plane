# =========================
# Python / Runtime
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual Environments
# =========================
.env
.venv
venv/
env/

# Conda
*.conda
.condarc

# =========================
# Testing
# =========================
.pytest_cache/

# =========================
# IDEs / Editors
# =========================
.vscode/
.idea/

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db

# =========================
# Databases (NEVER COMMIT)
# =========================
*.db
*.sqlite
*.sqlite3

# Explicit backend DB ignore
backend/db/*.db
backend/db/*.sqlite
backend/db/*.sqlite3

# =========================
# Runtime / Generated Data
# =========================
data/
backend/data/raw/*
backend/data/processed/*
backend/data/features/*

# Keep directory structure
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep
!backend/data/features/.gitkeep

# =========================
# Local-only artifacts
# =========================
dummy_document.txt
